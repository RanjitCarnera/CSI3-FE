    "start": "DISABLE_ESLINT_PLUGIN=true export PORT=3000 && react-app-rewired start",
    "build": "DISABLE_ESLINT_PLUGIN=true react-app-rewired build",
    "build:production": "DISABLE_ESLINT_PLUGIN=true env-cmd -f .env.production react-app-rewired build",
